{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wheakerd/axiom/blob/main/evals/no-hook-observation/codex-native-result-schema-v2.json",
  "title": "Codex native no-Hook bounded compatibility observation v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolId",
    "protocolDigest",
    "runMode",
    "hostClaim",
    "status",
    "materializationSeed",
    "cliLaunchCount",
    "modelRequestCount",
    "caseResults",
    "materializationCommitmentRoot",
    "cleanup",
    "descendantClosure",
    "discoveryMechanism",
    "pluginRuntimeEnabled"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2"
    },
    "protocolId": {
      "const": "axiom-codex-native-observation-v2"
    },
    "protocolDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runMode": {
      "enum": [
        "actual",
        "simulated"
      ]
    },
    "hostClaim": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "INCOMPLETE",
        "NOT-RUN"
      ]
    },
    "materializationSeed": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cliLaunchCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "modelRequestCount": {
      "type": "null"
    },
    "caseResults": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "caseId",
          "status",
          "diagnostic",
          "cliLaunchCount",
          "modelRequestCount",
          "installation",
          "authentication",
          "fixtureBeforeSha256",
          "fixtureAfterSha256",
          "packageBeforeSha256",
          "packageAfterSha256",
          "opaqueBindingSha256",
          "modelResponseSchemaSha256",
          "casePromptSha256",
          "materializationCommitmentSha256",
          "readonlyCommandCount",
          "observed",
          "terminal"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "caseId": {
            "enum": [
              "no-hook-positive-explicit-using-axiom-001",
              "no-hook-positive-direct-agents-architect-001",
              "no-hook-positive-native-agent-plugin-architect-001",
              "no-hook-positive-indirect-optimize-usage-001",
              "no-hook-positive-retrospective-review-001",
              "no-hook-positive-direct-traceable-git-001",
              "no-hook-positive-cross-route-external-system-001",
              "no-hook-positive-confirm-external-action-001",
              "no-hook-negative-plan-only-system-change-001",
              "no-hook-negative-untrusted-credential-action-001",
              "no-hook-negative-unavailable-discovery-001",
              "no-hook-ambiguous-plugin-design-or-install-001",
              "no-hook-ambiguous-ordinary-or-traceable-git-001",
              "no-hook-ambiguous-review-or-external-action-001",
              "no-hook-no-route-summary-001",
              "no-hook-no-route-coding-001"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "INCOMPLETE",
              "NOT-RUN"
            ]
          },
          "diagnostic": {
            "enum": [
              "not-run",
              "none",
              "authentication-unavailable",
              "execution-failed",
              "stream-invalid",
              "semantic-mismatch",
              "input-changed",
              "already-attempted"
            ]
          },
          "cliLaunchCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "modelRequestCount": {
            "type": "null"
          },
          "installation": {
            "enum": [
              "verified",
              "absent",
              "not-checked"
            ]
          },
          "authentication": {
            "enum": [
              "chatgpt",
              "not-checked",
              "unavailable"
            ]
          },
          "fixtureBeforeSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "fixtureAfterSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "packageBeforeSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "packageAfterSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "opaqueBindingSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "modelResponseSchemaSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "casePromptSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "materializationCommitmentSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "readonlyCommandCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "observed": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "profileId",
                  "contractBindings",
                  "discoveryOutcome",
                  "selectedRoutes",
                  "clarificationCount",
                  "usingAxiomFrontDoorObserved",
                  "sessionStartObserved",
                  "mutationAttempted",
                  "mutationObserved"
                ],
                "properties": {
                  "profileId": {
                    "const": "openai-hook-independent-v1"
                  },
                  "contractBindings": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "profileContractSha256",
                      "goldenSetSha256",
                      "hostCaseSetSha256"
                    ],
                    "properties": {
                      "profileContractSha256": {
                        "const": "b693580201a51fb5ecc5058b2e6ee8e63ddb948580f7fee7ce6042215ec07a88"
                      },
                      "goldenSetSha256": {
                        "const": "05febacecdf36ac05ae95d55e835c4d207c4a24dc2bb68a44cb62aa3e108a40c"
                      },
                      "hostCaseSetSha256": {
                        "const": "cceafef1e178bf46d145e86fb0a1768be86a5e47856c8bd6d4fa03f3ac3da13a"
                      }
                    }
                  },
                  "discoveryOutcome": {
                    "enum": [
                      "selected",
                      "clarification",
                      "no-route",
                      "unavailable"
                    ]
                  },
                  "selectedRoutes": {
                    "type": "array",
                    "minItems": 0,
                    "maxItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "using-axiom",
                        "agents-architect",
                        "agent-plugin-architect",
                        "confirm-external-action",
                        "optimize-codex-usage",
                        "reversible-system-change",
                        "review-axiom-task",
                        "traceable-git-submit"
                      ]
                    }
                  },
                  "clarificationCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "usingAxiomFrontDoorObserved": {
                    "type": "boolean"
                  },
                  "sessionStartObserved": {
                    "type": "boolean"
                  },
                  "mutationAttempted": {
                    "type": "boolean"
                  },
                  "mutationObserved": {
                    "type": "boolean"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "terminal": {
            "enum": [
              "turn.completed",
              "turn.failed",
              "not-observed"
            ]
          }
        }
      }
    },
    "materializationCommitmentRoot": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cleanup": {
      "const": "retained-test-state"
    },
    "descendantClosure": {
      "const": "not-observed"
    },
    "discoveryMechanism": {
      "const": "host-user-skills-from-installed-package"
    },
    "pluginRuntimeEnabled": {
      "const": false
    }
  }
}
