{
  "description": "Load Axiom's documented routing gate at session start, and print Axiom's static checks when a prompt arrives and before the turn ends.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s\\n\\n' 'You have Axiom. Load this startup front door before deciding whether any Axiom skill applies:'; cat \"${PLUGIN_ROOT}/skills/using-axiom/SKILL.md\"",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\codex-session-start.cmd\"",
            "timeout": 5,
            "statusMessage": "Loading Axiom routing"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s\\n' 'Axiom: material ambiguity that context cannot resolve is clarified before acting.'",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\codex-prompt-submit.cmd\"",
            "timeout": 5,
            "statusMessage": "Axiom prompt check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/stop-check.sh\" codex",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\codex-stop-check.cmd\"",
            "timeout": 5,
            "statusMessage": "Axiom completion check"
          }
        ]
      }
    ]
  }
}
