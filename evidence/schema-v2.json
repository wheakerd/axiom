{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axiom:compatibility-evidence:schema:v2",
  "title": "Axiom compatibility evidence record with runtime identity",
  "description": "A privacy-safe host observation bound to an immutable plugin release and deterministic installed-runtime contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "release",
    "runtimeIdentity",
    "observationSubject",
    "host",
    "installation",
    "hook",
    "reporter",
    "recordedAt",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2"
    },
    "release": {
      "$ref": "schema-v1.json#/$defs/release"
    },
    "runtimeIdentity": {
      "$ref": "#/$defs/runtimeIdentity"
    },
    "observationSubject": {
      "const": "installed-runtime-contract"
    },
    "host": {
      "$ref": "schema-v1.json#/$defs/host"
    },
    "installation": {
      "$ref": "schema-v1.json#/$defs/installation"
    },
    "hook": {
      "$ref": "schema-v1.json#/$defs/hook"
    },
    "reporter": {
      "$ref": "schema-v1.json#/$defs/reporter"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "schema-v1.json#/$defs/case"
      }
    }
  },
  "$defs": {
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginVersion",
        "runtimeContractSchemaVersion",
        "runtimeContractDigest"
      ],
      "properties": {
        "pluginVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "runtimeContractSchemaVersion": {
          "const": "1"
        },
        "runtimeContractDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
